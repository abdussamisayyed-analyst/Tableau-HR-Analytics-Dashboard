          <calculation class='tableau' formula='IF [Calculation_0544816964595713] &lt; 25 THEN &quot;Under 25&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 34 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 44 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 54 THEN &quot;45-54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
