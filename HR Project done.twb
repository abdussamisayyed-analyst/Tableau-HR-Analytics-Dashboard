      <aliases enabled='yes' />
      <column caption='Adjusted Salary' datatype='integer' name='[AdjustedSalary]' role='measure' type='quantitative' />
      <column caption='BirthDate (Employee Dim.csv)' datatype='date' name='[BirthDate (Employee_Dim.csv)]' role='dimension' type='ordinal' />
      <column caption='Birth Date' datatype='date' name='[BirthDate]' role='dimension' type='ordinal' />
      <column caption='Age' datatype='integer' name='[Calculation_0544816964595713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [BirthDate], TODAY())' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0544816964771842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0544816964595713] &lt; 25 THEN &quot;Under 25&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 34 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 44 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Calculation_0544816964595713] &lt;= 54 THEN &quot;45-54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Employee Name' datatype='string' name='[Calculation_0544817038155779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName] + &quot; &quot; + [LastName]' />
      </column>
      <column caption=' Average Tenure' datatype='integer' name='[Calculation_0827666989776896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[HireDate],[TerminationDate])' />
      </column>
      <column caption='Active Employees' datatype='string' name='[Calculation_1038497628024832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([TerminationDate]) THEN [EmployeeID] END' />
      </column>
      <column caption='Terminated Employees' datatype='string' name='[Calculation_1038497629061121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([TerminationDate]) THEN [EmployeeID] END' />
      </column>
      <column caption='Terminated Count' datatype='string' name='[Calculation_1038497631965186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([TerminationDate])&#13;&#10;THEN [EmployeeID]&#13;&#10;END' />
      </column>
      <column caption='Office Type' datatype='string' name='[Calculation_1038497640304643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [City] = &quot;New York&quot;&#13;&#10;THEN &quot;HQ&quot;&#13;&#10;ELSE &quot;Branch&quot;&#13;&#10;END' />
      </column>
